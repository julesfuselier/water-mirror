# Copy to .env.local for local dev (never commit .env.local).
# Without DATABASE_URL, `npm run dev` uses in-memory demo data from db/seed-data.json.

# Postgres connection string (added automatically by the Neon integration on Vercel)
DATABASE_URL=

# Key the ESP32 sends with each measurement (?key=... or header x-api-key)
DEVICE_API_KEY=

# Key required to wipe the history (POST /api/reset)
ADMIN_API_KEY=
